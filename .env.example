# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/sbi_cashback_tracking?retryWrites=true&w=majority
MONGODB_URI=

# Database Name (default: sbi_cashback_tracking)
DATABASE_NAME=sbi_cashback_tracking

# Admin Dashboard Password (used to log in at /admin)
ADMIN_PASSWORD=change_this_to_a_secure_admin_password

# Flask Session Secret Key (used for encrypting session cookies)
SECRET_KEY=change_this_to_a_random_secure_secret_key

# Optional Port configuration (default: 5000)
PORT=5000
